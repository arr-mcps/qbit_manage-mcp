# Base URL of your qbit_manage web server (no trailing /api)
QBIT_MANAGE_URL=http://qbit-manage.example.com:8181

# API key - generated in qbit_manage Web UI Settings > Security (sent as X-API-Key)
QBIT_MANAGE_API_KEY=

# Fallback: Basic auth credentials, used only when QBIT_MANAGE_API_KEY is unset
QBIT_MANAGE_USERNAME=
QBIT_MANAGE_PASSWORD=
